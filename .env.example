# ВАЖНО: значения пишутся БЕЗ inline-комментариев на той же строке.
# systemd EnvironmentFile считывает всё после "=" как значение (включая "# ...").
# Поэтому комментарии — только на отдельных строках над переменной.

# ── Backend (Kimi OAuth — опционально, нужно лишь для входа в веб-панель) ──
APP_ID=
APP_SECRET=

# ── Database ──
# MySQL connection string: mysql://user:pass@host:port/db
DATABASE_URL=

# ── Frontend (exposed to browser via Vite) ──
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# ── Backend (Auth) ──
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# ── Admin Role ──
# Union ID создателя приложения; получает роль "admin" при первом входе.
OWNER_UNION_ID=

# ── Hermes-as-a-Service (control-plane) ──
# Мастер-ключ шифрования секретов (сгенерировать: openssl rand -base64 48)
SECRETS_MASTER_KEY=
# Токен control-бота онбординга из @BotFather (отдельный от ботов пула)
CONTROL_BOT_TOKEN=
# Docker-образ агента на клиента (собирается из hermes-tenant/)
HERMES_IMAGE=hermes-tenant:latest
# Общий ключ OpenRouter владельца: на нём работают агенты клиентов (модель оплачиваешь ты)
OPENROUTER_API_KEY=
# Каталог на хосте для данных контейнеров клиентов
TENANTS_DATA_DIR=/srv/hermes-tenants
# Длительность пробного периода (дней)
TRIAL_DAYS=7
# Лимит памяти на контейнер клиента
TENANT_MEMORY_LIMIT=1g
# 1 = запуск без реального Docker (локальная разработка)
PROVISIONING_DRY_RUN=

# ── Billing (YooKassa) ──
# shopId из кабинета ЮKassa
YOOKASSA_SHOP_ID=
# Секретный ключ из кабинета ЮKassa
YOOKASSA_SECRET_KEY=
# Публичный базовый URL control-plane (для return_url и вебхука), напр. https://app.example.com
PUBLIC_BASE_URL=
# Сумма периодического платежа в копейках (49000 = 490.00 RUB)
BILLING_AMOUNT=49000
# Символическая сумма привязки карты в копейках (10000 = 100.00 RUB)
BILLING_BIND_AMOUNT=10000
# Код валюты
BILLING_CURRENCY=RUB
# Дней между автоплатежами
BILLING_PERIOD_DAYS=30
# 1 = слать фискальный чек 54-ФЗ (нужен email/телефон клиента)
YOOKASSA_SEND_RECEIPT=
# 1 = пропустить проверку IP вебхука (только для отладки)
YOOKASSA_SKIP_IP_CHECK=
# Контакт поддержки в условиях бота (напр. @your_support или email)
SUPPORT_CONTACT=
