# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Hermes-as-a-Service (control-plane) ─────────────────────────
SECRETS_MASTER_KEY=       # Master key for AES-256-GCM secret encryption (openssl rand -base64 48)
CONTROL_BOT_TOKEN=        # Telegram token of the onboarding control bot (separate from the pool)
HERMES_IMAGE=hermes-tenant:latest   # Per-tenant Docker image (built from hermes-tenant/)
TENANTS_DATA_DIR=/srv/hermes-tenants # Host dir for per-tenant persistent data volumes
TRIAL_DAYS=7              # Free trial length in days
TENANT_MEMORY_LIMIT=1g    # Docker --memory limit per tenant container
PROVISIONING_DRY_RUN=     # Set to 1 to run control-plane without a real Docker daemon (dev)

# ── Billing (YooKassa) ──────────────────────────────────────────
YOOKASSA_SHOP_ID=         # shopId from YooKassa dashboard
YOOKASSA_SECRET_KEY=      # Secret API key from YooKassa dashboard
PUBLIC_BASE_URL=          # Public base URL of control-plane (for return_url + webhook), e.g. https://app.example.com
BILLING_AMOUNT=49000      # Recurring charge in kopecks (49000 = 490.00 RUB)
BILLING_BIND_AMOUNT=10000 # Symbolic first charge to bind a card, in kopecks (10000 = 100.00 RUB)
BILLING_CURRENCY=RUB      # Currency code
BILLING_PERIOD_DAYS=30    # Days between recurring charges
YOOKASSA_SEND_RECEIPT=    # Set to 1 to send 54-FZ fiscal receipt (requires customer email/phone)
YOOKASSA_SKIP_IP_CHECK=   # Set to 1 to skip webhook sender IP verification (dev only)
SUPPORT_CONTACT=          # Support contact shown in bot terms (e.g. @your_support or email)
